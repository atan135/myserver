# Production strict discovery overlay. Merge with real production secrets and deploy-specific endpoints.
NODE_ENV=production
REGISTRY_ENABLED=true
DISCOVERY_REQUIRED=true
DISALLOW_LEGACY_DIRECT_CONFIG=true
REGISTRY_URL=redis://redis:6379
REGISTRY_KEY_PREFIX=
SERVICE_ZONE=prod
MAIL_CLAIM_NEW_REQUESTS_ENABLED=true
MAIL_CLAIM_RECOVERY_ENABLED=true
# Caddy is attached to deploy/docker/compose.production.yml's internal network.
# Replace this only when the deployed internal network is changed deliberately.
MAIL_PLAYER_AUTH_REQUIRED=true
MAIL_TRUST_PROXY=true
MAIL_TRUSTED_PROXY_CIDRS=172.30.0.0/24
MAIL_PUBLIC_RATE_LIMIT_ENABLED=true
