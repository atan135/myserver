NATS_URL=nats://127.0.0.1:4222
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
METRICS_SUBJECT=myserver.metrics.>

# METRICS_KEY_PREFIX falls back to REDIS_KEY_PREFIX, then an empty prefix.
# Use a complete environment prefix for shared Redis, for example prod:cn-shenzhen-a:.
METRICS_KEY_PREFIX=

# Legacy metrics keys are retained during the v2 reader migration.
METRICS_TTL_SECONDS=604800
METRICS_HEARTBEAT_TTL_SECONDS=30

# Metrics v2 bounded read model. METRICS_STORAGE_SCHEMA_VERSION is fixed at 2.
METRICS_STORAGE_SCHEMA_VERSION=2
METRICS_LATEST_TTL_SECONDS=180
METRICS_LATEST_INDEX_TTL_SECONDS=300
METRICS_HISTORY_RETENTION_SECONDS=4500
METRICS_MAX_INSTANCES_PER_SERVICE=64
METRICS_HISTORY_INDEX_MAX_MEMBERS=900
METRICS_MAX_RECORD_BYTES=16384

# metrics-collector is a NATS/Redis worker and does not participate in discovery.
# It does not expose a connectable endpoint; keep endpoint registration disabled unless that changes.
SERVICE_REGISTRY_REGISTER=false
REGISTRY_ENABLED=false
REGISTRY_URL=redis://127.0.0.1:6379
REGISTRY_KEY_PREFIX=
DISCOVERY_REQUIRED=false
SERVICE_NAME=metrics-collector
SERVICE_INSTANCE_ID=metrics-collector-001
SERVICE_ZONE=local
SERVICE_BUILD_VERSION=dev
