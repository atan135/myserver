# Copy to an operator-only file and replace every placeholder before deployment.
RELEASE_ID=v0.1.0-REPLACE_WITH_GIT_SHA

# Each application image must be pinned by digest from images.lock.json.
IMAGE_GAME_SERVER=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/game-server@sha256:REPLACE
IMAGE_GAME_PROXY=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/game-proxy@sha256:REPLACE
IMAGE_CHAT_SERVER=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/chat-server@sha256:REPLACE
IMAGE_MATCH_SERVICE=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/match-service@sha256:REPLACE
IMAGE_AUTH_HTTP=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/auth-http@sha256:REPLACE
IMAGE_ADMIN_API=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/admin-api@sha256:REPLACE
IMAGE_ANNOUNCE_SERVICE=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/announce-service@sha256:REPLACE
IMAGE_MAIL_SERVICE=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/mail-service@sha256:REPLACE
IMAGE_METRICS_COLLECTOR=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/metrics-collector@sha256:REPLACE
IMAGE_CADDY=crpi-aag02un1ijrswhes.cn-shenzhen.personal.cr.aliyuncs.com/zerg-myserver/caddy@sha256:REPLACE

# Pin public infrastructure images to audited digests before first production use.
POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_AUDITED_DIGEST
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_AUDITED_DIGEST
NATS_IMAGE=nats:2-alpine@sha256:REPLACE_WITH_AUDITED_DIGEST

# These paths are local to the server and must not be committed.
INFRA_ENV_FILE=/data/myserver/secrets/infrastructure.env
AUTH_HTTP_ENV_FILE=/data/myserver/secrets/auth-http.env
ADMIN_API_ENV_FILE=/data/myserver/secrets/admin-api.env
ANNOUNCE_SERVICE_ENV_FILE=/data/myserver/secrets/announce-service.env
MAIL_SERVICE_ENV_FILE=/data/myserver/secrets/mail-service.env
METRICS_COLLECTOR_ENV_FILE=/data/myserver/secrets/metrics-collector.env
GAME_SERVER_ENV_FILE=/data/myserver/secrets/game-server.env
GAME_PROXY_ENV_FILE=/data/myserver/secrets/game-proxy.env
CHAT_SERVER_ENV_FILE=/data/myserver/secrets/chat-server.env
MATCH_SERVICE_ENV_FILE=/data/myserver/secrets/match-service.env

# Caddy obtains certificates automatically after both names resolve to this server.
CADDY_AUTH_HOST=api.example.com
CADDY_ADMIN_HOST=admin.example.com
CADDY_EMAIL=ops@example.com
GAME_PROXY_UDP_PORT=4000
GAME_PROXY_ADVERTISED_HOST=game.example.com
GAME_CSV_DIR=/data/myserver/release/config/csv
