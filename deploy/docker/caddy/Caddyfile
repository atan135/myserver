{
    email {$CADDY_EMAIL}
    servers {
        timeouts {
            read_header 5s
            idle 2m
        }
        max_header_size 16KB
    }
}

{$CADDY_LANDING_HOST} {
    encode zstd gzip
    header {
        -Server
        Cache-Control "public, max-age=300"
        Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        Permissions-Policy "camera=(), geolocation=(), microphone=()"
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }

    handle / {
        root * /srv/landing
        rewrite * /index.html
        file_server
    }

    handle {
        respond 404
    }
}

{$CADDY_AUTH_HOST} {
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    # Auth and player mail/announcement reads share this public hostname. Do
    # not record an URI (which includes query strings) or credentials.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers>Authorization delete
                request>headers>Cookie delete
                request>headers>X-Game-Ticket delete
                request>headers>X-Read-Token delete
                request>headers>X-Service-Token delete
                request>headers>X-Admin-Token delete
                request>headers>X-Mail-Operations-Token delete
                request>headers>X-Mail-High-Risk-Token delete
            }
        }
    }

    log_append request_id {http.request.uuid}

    # route preserves the following order: all player-service-shaped requests
    # terminate locally or at their service and never fall through to auth-http.
    route {
        @internal_api path /api/v1/internal /api/v1/internal/*
        respond @internal_api 404

        @mail_namespace path /api/v1/mails*
        handle @mail_namespace {
            route {
                # `orig_uri` is deliberately used for raw escaped-path checks.
                # Exact path matchers work on decoded paths, so checking only
                # them would allow encoded slash, dot, or backslash variants.
                @mail_uri_too_long expression `size({http.request.orig_uri}) > 2048`
                respond @mail_uri_too_long 414

                @mail_unsafe_path expression `{http.request.orig_uri}.matches('(?i).*(?:%25)*(?:%2f|%5c|%2e).*') || {http.request.orig_uri.path}.contains("\\") || {http.request.orig_uri.path}.contains(";") || {http.request.orig_uri.path}.contains("//") || {http.request.orig_uri.path}.contains("/./") || {http.request.orig_uri.path}.contains("/../")`
                respond @mail_unsafe_path 404

                @mail_x_http_method_override header X-HTTP-Method-Override *
                respond @mail_x_http_method_override 404
                @mail_x_method_override header X-Method-Override *
                respond @mail_x_method_override 404
                @mail_query_method_override query _method=*
                respond @mail_query_method_override 404

                # Classify the route before credentials. A system-send method
                # must remain a local 405 even without a player ticket, and an
                # extra mail subpath must remain a local 404.
                @mail_known_path_wrong_method expression `(path_regexp('^/api/v1/mails$') && !method('GET')) || (path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}$') && !method('GET')) || (path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}/read$') && !method('PUT')) || (path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}/claim$') && !method('POST'))`
                respond @mail_known_path_wrong_method 405
                @mail_unknown_path expression `!(path_regexp('^/api/v1/mails$') || path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}$') || path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}/read$') || path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}/claim$'))`
                respond @mail_unknown_path 404

                # Do not accept chunked bodies on the small player mutation
                # endpoints. Go's HTTP parser rejects duplicate Host headers
                # before a Caddy handler runs; every remaining singleton below
                # is rejected if Caddy's joined placeholder contains a comma.
                @mail_transfer_encoding header Transfer-Encoding *
                respond @mail_transfer_encoding 400
                @mail_repeated_singletons expression `{http.request.header.Content-Length}.contains(",") || {http.request.header.X-Request-ID}.contains(",") || {http.request.header.X-Forwarded-For}.contains(",") || {http.request.header.X-Forwarded-Proto}.contains(",") || {http.request.header.X-Forwarded-Host}.contains(",") || {http.request.header.X-Real-IP}.contains(",")`
                respond @mail_repeated_singletons 400

                # The public player contract accepts exactly one compact game
                # ticket and no alternate service/admin credential channel.
                @mail_missing_ticket expression `size({http.request.header.X-Game-Ticket}) == 0`
                respond @mail_missing_ticket 401
                @mail_invalid_ticket expression `size({http.request.header.X-Game-Ticket}) > 4096 || {http.request.header.X-Game-Ticket}.contains(",") || !{http.request.header.X-Game-Ticket}.matches("^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$")`
                respond @mail_invalid_ticket 401
                @mail_conflicting_credentials expression `size({http.request.header.Authorization}) > 0 || size({http.request.header.Proxy-Authorization}) > 0 || size({http.request.header.X-Service-Token}) > 0 || size({http.request.header.X-Admin-Token}) > 0 || size({http.request.header.Cookie}) > 0`
                respond @mail_conflicting_credentials 400

                # Reads have no body. The two mutation endpoints remain capped
                # before mail-service performs its body-schema validation.
                @mail_read_with_body expression `method('GET') && size({http.request.header.Content-Length}) > 0 && {http.request.header.Content-Length} != "0"`
                respond @mail_read_with_body 400
                request_body {
                    max_size 1024
                }

                @mail_player_route expression `(method('GET') && path_regexp('^/api/v1/mails$')) || (method('GET') && path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}$')) || (method('PUT') && path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}/read$')) || (method('POST') && path_regexp('^/api/v1/mails/[A-Za-z0-9:_-]{1,64}/claim$'))`
                handle @mail_player_route {
                    reverse_proxy mail-service:9003 {
                        # Overwrite every public proxy/request-id claim at
                        # this edge. Do not pair header_up deletion and set
                        # operations for the same field: Caddy applies the
                        # combined deletion after the set. mail-service must
                        # separately trust only Caddy's internal CIDR before
                        # consuming these values.
                        header_up X-Forwarded-For {http.request.remote.host}
                        header_up X-Forwarded-Proto https
                        header_up X-Forwarded-Host {http.request.host}
                        header_up X-Real-IP {http.request.remote.host}
                        header_up X-Request-ID {http.request.uuid}
                        header_down Cache-Control "private, no-store"
                        transport http {
                            max_response_header 16KB
                            dial_timeout 3s
                            response_header_timeout 5s
                            read_timeout 12s
                            write_timeout 5s
                        }
                    }
                }

            }
        }

        @announce_namespace path /api/v1/announcements*
        handle @announce_namespace {
            route {
                # `orig_uri` is deliberately used for raw escaped-path checks.
                # Exact path matchers work on decoded paths, so checking only
                # them would allow encoded slash, dot, or backslash variants.
                @announce_uri_too_long expression `size({http.request.orig_uri}) > 2048`
                respond @announce_uri_too_long 414

                @announce_unsafe_path expression `{http.request.orig_uri}.matches('(?i).*(?:%25)*(?:%2f|%5c|%2e).*') || {http.request.orig_uri.path}.contains("\\") || {http.request.orig_uri.path}.contains(";") || {http.request.orig_uri.path}.contains("//") || {http.request.orig_uri.path}.contains("/./") || {http.request.orig_uri.path}.contains("/../")`
                respond @announce_unsafe_path 404

                @announce_x_http_method_override header X-HTTP-Method-Override *
                respond @announce_x_http_method_override 404
                @announce_x_method_override header X-Method-Override *
                respond @announce_x_method_override 404
                @announce_query_method_override query _method=*
                respond @announce_query_method_override 404

                # The public player contract exposes only announcement reads.
                # Keep write verbs local even when callers omit a ticket.
                @announce_known_path_wrong_method expression `(path_regexp('^/api/v1/announcements$') && !method('GET')) || (path_regexp('^/api/v1/announcements/[A-Za-z0-9:_-]{1,64}$') && !method('GET'))`
                respond @announce_known_path_wrong_method 405
                @announce_unknown_path expression `!(path_regexp('^/api/v1/announcements$') || path_regexp('^/api/v1/announcements/[A-Za-z0-9:_-]{1,64}$'))`
                respond @announce_unknown_path 404

                # Reads never carry a body. Go's HTTP parser rejects duplicate
                # Host headers before Caddy runs; reject all other singleton
                # duplicates that affect request attribution or framing.
                @announce_transfer_encoding header Transfer-Encoding *
                respond @announce_transfer_encoding 400
                @announce_repeated_singletons expression `{http.request.header.Content-Length}.contains(",") || {http.request.header.X-Request-ID}.contains(",") || {http.request.header.X-Forwarded-For}.contains(",") || {http.request.header.X-Forwarded-Proto}.contains(",") || {http.request.header.X-Forwarded-Host}.contains(",") || {http.request.header.X-Real-IP}.contains(",")`
                respond @announce_repeated_singletons 400

                # Player reads accept exactly one compact game ticket. Read,
                # service, admin, bearer, proxy, and cookie credentials are
                # deliberately unavailable on this public route.
                @announce_missing_ticket expression `size({http.request.header.X-Game-Ticket}) == 0`
                respond @announce_missing_ticket 401
                @announce_invalid_ticket expression `size({http.request.header.X-Game-Ticket}) > 4096 || {http.request.header.X-Game-Ticket}.contains(",") || !{http.request.header.X-Game-Ticket}.matches("^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$")`
                respond @announce_invalid_ticket 401
                @announce_conflicting_credentials expression `size({http.request.header.Authorization}) > 0 || size({http.request.header.Proxy-Authorization}) > 0 || size({http.request.header.X-Read-Token}) > 0 || size({http.request.header.X-Service-Token}) > 0 || size({http.request.header.X-Admin-Token}) > 0 || size({http.request.header.Cookie}) > 0`
                respond @announce_conflicting_credentials 400

                @announce_read_with_body expression `method('GET') && size({http.request.header.Content-Length}) > 0 && {http.request.header.Content-Length} != "0"`
                respond @announce_read_with_body 400
                request_body {
                    max_size 1024
                }

                @announce_player_route expression `(method('GET') && path_regexp('^/api/v1/announcements$')) || (method('GET') && path_regexp('^/api/v1/announcements/[A-Za-z0-9:_-]{1,64}$'))`
                handle @announce_player_route {
                    reverse_proxy announce-service:9004 {
                        # Replace every client-supplied proxy/request-id value
                        # at the public edge before announce-service evaluates
                        # its trusted-proxy policy.
                        header_up X-Forwarded-For {http.request.remote.host}
                        header_up X-Forwarded-Proto https
                        header_up X-Forwarded-Host {http.request.host}
                        header_up X-Real-IP {http.request.remote.host}
                        header_up X-Request-ID {http.request.uuid}
                        header_down Cache-Control "private, no-store"
                        transport http {
                            max_response_header 16KB
                            dial_timeout 3s
                            response_header_timeout 5s
                            read_timeout 12s
                            write_timeout 5s
                        }
                    }
                }
            }
        }

        handle {
            # Mail is intentionally outside this handler so player-private
            # responses cannot be Caddy-compressed.
            encode zstd gzip
            reverse_proxy auth-http:3000
        }
    }

    # Do not expose a container address or an auth catch-all response when an
    # allowed mail request cannot reach the internal upstream.
    handle_errors {
        @mail_upstream_error path /api/v1/mails*
        respond @mail_upstream_error 503
        @announce_upstream_error path /api/v1/announcements*
        respond @announce_upstream_error 503
    }
}

{$CADDY_ADMIN_HOST} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    @admin_api path /api/*
    handle @admin_api {
        reverse_proxy admin-api:3001
    }

    handle {
        root * /srv/admin-web
        try_files {path} /index.html
        file_server
    }
}

{$CADDY_CHAT_HOST} {
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    # The URI is removed as a whole so query credentials can never reach the
    # access log, even if a client violates the no-query-token contract.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers>Authorization delete
                request>headers>Cookie delete
                request>headers>Sec-Websocket-Protocol delete
            }
        }
    }

    log_append request_id {http.request.uuid}

    @chat_websocket {
        method GET
        path /
        header Connection *Upgrade*
        header Upgrade websocket
    }

    handle @chat_websocket {
        log_append route chat_websocket
        reverse_proxy {
            # Resolve all Docker DNS A records at request time. New upgrades are
            # spread deterministically; an established WebSocket stays pinned
            # to the selected upstream for its full lifetime.
            dynamic a chat-server 9011 {
                refresh 5s
            }
            lb_policy round_robin
            lb_retries 2
            lb_try_duration 5s
            fail_duration 15s
            max_fails 1
            # Caddy replaces X-Forwarded-* using the direct peer by default.
            # Always replace caller-provided request IDs at the public edge.
            header_up X-Request-ID {http.request.uuid}
            header_up X-Real-IP {http.request.remote.host}
            transport http {
                dial_timeout 3s
                response_header_timeout 5s
            }
        }
    }

    handle {
        log_append route rejected_non_websocket
        header Upgrade websocket
        respond 426
    }
}
